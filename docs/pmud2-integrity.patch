+class TransferIntegrity:
+    def __init__(self, params):
+        self.params = params
+
+    async def digest(self, remote, size, algorithm):
+        sha = hashlib.sha256()
+        selected = hashlib.new(algorithm)
+        async with asyncssh.connect(**self.params) as conn:
+            async with conn.start_sftp_client() as sftp:
+                before = await sftp.stat(remote)
+                if before.size != size:
+                    raise RuntimeError('远端文件大小验证失败')
+                async with sftp.open(remote, 'rb') as handle:
+                    for offset in range(0, size, CHUNK_SIZE):
+                        data = await _read_full(handle, min(CHUNK_SIZE, size - offset), offset)
+                        sha.update(data)
+                        selected.update(data)
+                after = await sftp.stat(remote)
+                if (after.size, after.mtime) != (before.size, before.mtime):
+                    raise RuntimeError('远端文件在校验期间发生变化')
+        return sha.hexdigest(), selected.hexdigest()
+
