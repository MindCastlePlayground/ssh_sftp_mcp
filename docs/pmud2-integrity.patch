+import asyncio
+import importlib.util
+from importlib.machinery import SourceFileLoader
+import os
+import tempfile
+import unittest
+from pathlib import Path
+
+import asyncssh
+
+
+ROOT = Path(__file__).parents[1]
+SPEC = importlib.util.spec_from_file_location("pmud2_candidate", ROOT / "sftp_tool.py")
+CANDIDATE = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(CANDIDATE)
+
+
+class FaultSFTP(asyncssh.SFTPServer):
+    def __init__(self, chan, root, state):
+        super().__init__(chan, chroot=os.fsencode(root))
+        self.state = state
+
+    async def read(self, file_obj, offset, length):
+        file_obj.seek(offset)
+        data = file_obj.read(length)
+        if self.state.get("short") and len(data) > 1:
+            return data[:max(1, min(8191, len(data)))]
+        return data
+
+    async def write(self, file_obj, offset, data):
+        if self.state.get("fail") and offset == 0:
+            raise asyncssh.SFTPFailure("injected write failure")
+        if self.state.get("corrupt") and offset == 0 and data:
+            return len(data)  # Acknowledge but drop the first range, leaving a same-size hole.
+        file_obj.seek(offset)
+        file_obj.write(data)
+        return len(data)
+
+
+class NoAuth(asyncssh.SSHServer):
+    def begin_auth(self, username):
+        return False
+
+
+class Fixture:
+    def __init__(self):
+        self.tmp = tempfile.TemporaryDirectory(prefix="pmud2-sftp-")
+        self.root = Path(self.tmp.name)
+        self.state = {}
+        self.key = asyncssh.generate_private_key("ssh-rsa")
+        self.listener = None
+
+    async def start(self):
+        self.listener = await asyncssh.listen(
+            "127.0.0.1", 0, server_factory=NoAuth,
+            server_host_keys=[self.key],
+            sftp_factory=lambda chan: FaultSFTP(chan, self.root, self.state),
+        )
+        self.params = {"host": "127.0.0.1", "port": self.listener.get_port(),
+                       "username": "u", "password": "p", "known_hosts": None}
+
+    async def stop(self):
+        if self.listener:
+            self.listener.close()
+            await self.listener.wait_closed()
+        self.tmp.cleanup()
+
+
+class IntegrityTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.fixture = Fixture()
+        await self.fixture.start()
+        self.local = Path(tempfile.mkdtemp(prefix="pmud2-local-"))
+
+    async def asyncTearDown(self):
+        for item in self.local.glob("*"):
+            item.unlink(missing_ok=True)
+        self.local.rmdir()
+        await self.fixture.stop()
+
+    def uploader(self):
+        return CANDIDATE.SFTPUploader(self.fixture.params)
+
+    def downloader(self):
+        return CANDIDATE.SFTPDownloader(self.fixture.params)
+
+    async def test_large_roundtrip(self):
+        source = self.local / "large.bin"
+        source.write_bytes((b"0123456789abcdef" * (17 * 1024 * 1024 // 16 + 1))[:17 * 1024 * 1024 + 137])
+        uploaded = await self.uploader().upload_async(str(source), "large.bin", 2)
+        target = self.local / "download.bin"
+        downloaded = await self.downloader().download_async("large.bin", str(target), source.stat().st_size, 2)
+        self.assertTrue(uploaded["verify_passed"])
+        self.assertTrue(downloaded["verify_passed"])
+        self.assertEqual(source.read_bytes(), target.read_bytes())
+
+    async def test_empty_roundtrip(self):
+        source = self.local / "empty.bin"
+        source.write_bytes(b"")
+        await self.uploader().upload_async(str(source), "empty.bin", 2)
+        target = self.local / "empty.out"
+        await self.downloader().download_async("empty.bin", str(target), 0, 2)
+        self.assertEqual(target.read_bytes(), b"")
+
+    async def test_corrupt_upload_fails_and_old_target_stays(self):
+        source = self.local / "source.bin"
+        source.write_bytes(b"correct payload" * 1000)
+        self.fixture.root.joinpath("target.bin").write_bytes(b"old target")
+        self.fixture.state["corrupt"] = True
+        with self.assertRaises(RuntimeError):
+            await self.uploader().upload_async(str(source), "target.bin", 2)
+        self.assertEqual(self.fixture.root.joinpath("target.bin").read_bytes(), b"old target")
+        self.assertEqual(list(self.fixture.root.glob("target.bin.part-*")), [])
+
+    async def test_short_read_download_succeeds(self):
+        payload = b"short read payload" * 10000
+        self.fixture.root.joinpath("short.bin").write_bytes(payload)
+        self.fixture.state["short"] = True
+        target = self.local / "short.out"
+        await self.downloader().download_async("short.bin", str(target), len(payload), 2)
+        self.assertEqual(target.read_bytes(), payload)
+
+    async def test_wrong_supplied_hash_preserves_old_local_target(self):
+        payload = b"remote payload" * 500
+        self.fixture.root.joinpath("remote.bin").write_bytes(payload)
+        target = self.local / "remote.out"
+        target.write_bytes(b"old local target")
+        with self.assertRaises(RuntimeError):
+            await self.downloader().download_async("remote.bin", str(target), len(payload), 2, remote_hash="0" * 32)
+        self.assertEqual(target.read_bytes(), b"old local target")
+        self.assertEqual(list(self.local.glob("remote.out.part-*")), [])
+
+    async def test_worker_failure_cleans_staging(self):
+        source = self.local / "failure.bin"
+        source.write_bytes(b"failure payload" * 10000)
+        self.fixture.state["fail"] = True
+        with self.assertRaises(Exception):
+            await self.uploader().upload_async(str(source), "failure.bin", 2)
+        self.assertEqual(list(self.fixture.root.glob("failure.bin.part-*")), [])
+
+    async def test_original_verify_false_baseline_accepts_corruption(self):
+        baseline_value = os.environ.get("PMUD2_BASELINE_FILE")
+        if not baseline_value:
+            self.skipTest("set PMUD2_BASELINE_FILE to run the baseline reproduction")
+        baseline_path = Path(baseline_value)
+        if not baseline_path.exists():
+            self.skipTest("PMUD2 baseline snapshot is unavailable")
+        spec = importlib.util.spec_from_loader("pmud2_baseline", SourceFileLoader("pmud2_baseline", str(baseline_path)))
+        baseline = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(baseline)
+        source = self.local / "baseline.bin"
+        payload = b"baseline payload" * 1000
+        source.write_bytes(payload)
+        self.fixture.state["corrupt"] = True
+        result = await baseline.SFTPUploader(self.fixture.params).upload_async(str(source), "baseline.bin", 2, verify=False)
+        self.assertEqual(result["file_size"], len(payload))
+        self.assertIsNone(result["verify_passed"])
+        self.assertNotEqual(self.fixture.root.joinpath("baseline.bin").read_bytes(), payload)
+
+
+if __name__ == "__main__":
+    unittest.main()
